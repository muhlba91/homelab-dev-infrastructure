# Paseo (agent orchestration, D63): a systemd user unit of the host's user, so agents get the user
# manager's environment (DOCKER_HOST, the Vault and fnox settings, nix-ld) like the workspaces.
# The web UI, apps and API share one port (the cluster's gateway forwards the public name to it);
# every request needs the password (secret `paseo-env`, generated by Pulumi). Only environment
# variables configure it: they win over ~/.paseo/config.json, which stays Paseo's own, so settings
# changed in its UI (providers, profiles, idle cleanup) survive deploys. Agents run the user's
# `claude` (claude-code.nix) with the user's login, and inherit PASEO_PASSWORD (Paseo passes it on,
# so agents can start other agents with the CLI; the same user can read the secret anyway). No
# backup (D11): state and managed worktrees live in ~/.paseo on the data disk.
{
  config,
  lib,
  pkgsUnstable,
  ...
}:
let
  cfg = config.dev;
  u = cfg.user;
  p = cfg.paseo;
  inherit (config.users.users.${u.name}) home;
  # From nixos-unstable: the release lags upstream's frequent releases.
  package = pkgsUnstable.paseo;
in
lib.mkIf p.enable {
  # The CLI (`paseo ls`, `paseo run`, ...). Every client needs the password, the CLI on the host
  # too (loopback is not exempt): interactive shells of the user get it from the secret.
  environment.systemPackages = [ package ];
  environment.interactiveShellInit = ''
    if [ -r ${config.dev.secrets.paseo-env.path} ]; then
      export "$(cat ${config.dev.secrets.paseo-env.path})"
    fi
  '';

  # PASEO_PASSWORD=…; systemd reads it as the user. A rotation restarts the daemon (it reads the
  # password at start), which interrupts running agents.
  dev.secrets.paseo-env = {
    owner = u.name;
    mode = "0400";
    reload = "systemctl --machine=${u.name}@.host --user try-restart paseo.service";
  };

  systemd.user.services.paseo = {
    description = "Paseo daemon";
    wantedBy = [ "default.target" ];
    unitConfig.ConditionUser = u.name;
    # A deploy restarting the daemon would interrupt running agents: a new version runs after
    # `systemctl --user restart paseo` or a reboot (dev-health warns while an older one runs).
    restartIfChanged = false;
    environment = {
      PASEO_HOME = "${home}/.paseo";
      PASEO_LISTEN = "0.0.0.0:${toString p.port}";
      PASEO_WEB_UI_ENABLED = "true";
      # The gateway reaches the host from the cluster's pods: X-Forwarded-* from the trusted
      # networks (as Coder's CODER_PROXY_TRUSTED_ORIGINS; the password guards every request). The
      # daemon listens on IPv4 only, like the gateway's path to it.
      PASEO_TRUSTED_PROXIES = lib.concatStringsSep "," (
        [ "loopback" ] ++ cfg.trusted.v4 ++ cfg.trusted.v6
      );
      USE_BUILTIN_RIPGREP = "0";
      # As a login shell: claude (~/.local/bin), the mise shims (each repository's tools), the
      # system and the user's profile.
      PATH = lib.mkForce (
        lib.concatStringsSep ":" [
          "${home}/.local/bin"
          "${home}/.local/share/mise/shims"
          "/run/wrappers/bin"
          "/etc/profiles/per-user/${u.name}/bin"
          "/run/current-system/sw/bin"
        ]
      );
    }
    // lib.optionalAttrs (p.hostname != null) { PASEO_HOSTNAMES = p.hostname; };
    preStart = "mkdir -p -m 0700 ${home}/.paseo";
    serviceConfig = {
      ExecStart = "${package}/bin/paseo-server --no-relay";
      EnvironmentFile = config.dev.secrets.paseo-env.path;
      Restart = "on-failure";
      RestartSec = 5;
      # The daemon stops gracefully on SIGTERM within 10 seconds.
      TimeoutStopSec = 15;
    };
  };
}
