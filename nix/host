#!/bin/sh
# Host commands. Stage 2 of the Pulumi -> NixOS chain: Pulumi renders
#   $OUTPUTS/hosts/<host>/vars.nix          the data (no secrets; the flake's `hosts` input)
#   $OUTPUTS/keys/<host>/deploy-key         private SSH key of the `deploy` user (stays on this machine)
#   $OUTPUTS/keys/<host>/secrets/<name>     secret files for the host (e.g. github-ssh-key)
# and ends; everything below runs from there, through ./nx (podman).
#
#   ./host hosts                         list hosts (in deploy order): deployable, deployed by CI
#   ./host check                         flake checks: lint, deploy schema, eval tests, every host
#   ./host fmt                           format all .nix files (nixfmt, the flake's formatter)
#   ./host dump <host>                   evaluated config as JSON (diff before/after a refactor)
#   ./host push-secrets <host>           deliver $OUTPUTS/keys/<host>/secrets/ to the host
#   ./host deploy <host> [deploy args]   push secrets, run the host's backups, then deploy-rs (magic
#                                        rollback); without args, skipped if the host already runs
#                                        this system. SKIP_BACKUP=1: no backup first
#   ./host health <host>                 dev-health (modules/health.nix)
#   ./host install <host> <ip>           first install / reinstall: nixos-anywhere (+ secrets);
#                                        wipes the OS disk, never the data disk (label `data`)
#   ./host ssh <host> [command]          SSH as `deploy` to the host's mgmt address with its key
#
# OUTPUTS=<dir> selects the host data (default ../infrastructure/outputs, written by Pulumi);
# any folder of the same layout works. Without host data: the fixtures in tests/hosts.
set -eu
cd "$(dirname "$0")"
usage() { sed -n '2,22p' "$0"; exit 1; }
die() { echo "host: $*" >&2; exit 1; }
SECRETS_DIR=/var/lib/secrets # must match modules/secrets.nix

OVERRIDE=""
if [ -d "${OUTPUTS:-../infrastructure/outputs}/hosts" ]; then
  OUTPUTS=$(cd "${OUTPUTS:-../infrastructure/outputs}" && pwd)
  case "$OUTPUTS/" in "$PWD"/*) die "OUTPUTS must be outside nix/ (it holds keys; nix/ is copied into the Nix store)" ;; esac
  # hosts/ is copied into the Nix store as a whole: refuse anything but <host>/ folders
  # holding a regular file vars.nix.
  S="$OUTPUTS/hosts"
  stray=$(find "$S" -mindepth 1 \( -path "$S/*/*/*" -o -path "$S/*/*" ! -path "$S/*/vars.nix" -o -path "$S/*/vars.nix" ! -type f -o ! -path "$S/*/*" ! -type d \))
  [ -z "$stray" ] || die "only <host>/vars.nix may be in $S (it enters the Nix store):
$stray"
  export NX_HOSTS="$S"
  OVERRIDE="--override-input hosts path:$S"
elif [ -n "${OUTPUTS:-}" ]; then
  die "no host data at $OUTPUTS/hosts"
else
  echo "host: no host data (run pulumi up, or set OUTPUTS): using the fixtures in tests/hosts" >&2
fi

# nix eval: stdout; stderr only on failure (--override-input always prints a lock warning).
ev() {
  err=$(mktemp)
  # shellcheck disable=SC2086
  ./nx -r nix eval $OVERRIDE "$@" 2>"$err" || { cat "$err" >&2; rm -f "$err"; exit 1; }
  rm -f "$err"
}
# A deployable host for the SSH commands: sets MGMT and hands its keys and pinned host key
# (a known_hosts line) to ./nx. The flake output `hostTarget.<host>` (deployable hosts
# only) is "<mgmt address>[ <host key>]".
target() {
  [ -n "$OVERRIDE" ] || die "no host data (the fixtures are not deployable)"
  t=$(ev --raw ".#hostTarget.\"$1\"") || die "no deployable host '$1'"
  MGMT=${t%% *}
  known=""; [ "$t" = "$MGMT" ] || known=$t
  export NX_KEYS="$OUTPUTS/keys" DEPLOY_KEY="$OUTPUTS/keys/$1/deploy-key" NX_KNOWN_HOSTS="$known"
}

push_secrets() {
  src="$OUTPUTS/keys/$1/secrets"
  if [ ! -d "$src" ]; then echo "host: no $src, nothing to push"; return 0; fi
  echo "host: pushing $src -> deploy@$MGMT:$SECRETS_DIR"
  # secrets-sync.sh travels with the push (base64: no quoting through the container and SSH).
  sync=$(base64 <secrets-sync.sh | tr -d '\n')
  ./nx -r sh -c "tar -C $src -cf - . | ssh deploy@$MGMT 'sudo sh -c \"\$(echo $sync | base64 -d)\" sh $SECRETS_DIR ${2:-}'"
}

cmd=${1:-}; host=${2:-}
case "$cmd" in hosts | check | fmt) ;; *) [ -n "$host" ] || usage; shift 2 ;; esac
case "$cmd" in
  hosts)
    ev --raw .#hostList ;;
  check)
    # shellcheck disable=SC2086
    ./nx -r nix flake check -L --keep-going $OVERRIDE || die "checks failed" ;;
  fmt)
    ./nx -r nix fmt ;;
  dump)
    ev --json ".#hostDump.\"$host\"" ;;
  push-secrets)
    target "$host"; push_secrets "$host" ;;
  deploy)
    target "$host"
    case " $* " in *" --dry-activate "*) dry=1 ;; *) dry=0 ;; esac
    if [ $# -eq 0 ]; then
      want=$(ev --raw ".#nixosConfigurations.\"$host\".config.system.build.toplevel.outPath")
      have=$(./nx -r ssh "deploy@$MGMT" readlink /run/current-system)
      if [ "$want" = "$have" ]; then push_secrets "$host" prune; echo "host: $host already runs $want"; exit 0; fi
    fi
    if [ "$dry" = 1 ]; then echo "host: dry run, secrets not pushed"; else push_secrets "$host"; fi
    # The system changes: back up the databases first (a schema migration cannot be rolled
    # back, a dump can). A failed backup stops the deploy. Hosts without backups have no unit.
    if [ "$dry" = 0 ] && [ "${SKIP_BACKUP:-0}" != 1 ]; then
      # shellcheck disable=SC2016 # expands on the host
      ./nx -r ssh "deploy@$MGMT" 'for u in $(systemctl list-unit-files --no-legend "restic-backups-*.service" | cut -d" " -f1); do
          echo "host: backup ($u)"; sudo systemctl start "$u" || exit 1; done' || die "backup failed (SKIP_BACKUP=1 deploys without)"
    fi
    # --skip-checks: `./host check` is the gate (deploy-rs would rerun every check).
    # shellcheck disable=SC2086
    ./nx deploy --skip-checks ".#$host" "$@" -- $OVERRIDE
    # Only after the deploy: a rollback may still need them.
    [ "$dry" = 1 ] || push_secrets "$host" prune ;;
  ssh)
    target "$host"
    exec ./nx -r ssh "deploy@$MGMT" "$@" ;;
  health)
    target "$host"
    exec ./nx -r ssh "deploy@$MGMT" sudo dev-health ;;
  install)
    ip=${1:-}; [ -n "$ip" ] || usage
    target "$host"
    export NX_KNOWN_HOSTS="" # the installer's host key is not the host's
    disk=$(ev --raw ".#nixosConfigurations.\"$host\".config.dev.hardware.disk")
    label=$(ev --raw ".#nixosConfigurations.\"$host\".config.dev.storage.dataLabel")
    echo "host: install of '$host' on root@$ip (wipes $disk; keeps the data disk, label $label)"
    ./nx sh install.sh "$host" "$ip" "$disk" "$label" "$NX_HOSTS" "$OUTPUTS/keys/$host/secrets" "$SECRETS_DIR" ;;
  *)
    usage ;;
esac
