{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "github>muhlba91/renovate-config",
        "github>muhlba91/renovate-config:automerge(patch)",
        "github>muhlba91/renovate-config:automerge(minor)",
        "github>muhlba91/renovate-config:group-go",
        "github>muhlba91/renovate-config:group-pulumi"
    ],
    "timezone": "Europe/Vienna",
    "enabledManagers": [
        "dockerfile",
        "github-actions",
        "gomod",
        "nix",
        "pre-commit",
        "mise",
        "terraform"
    ],
    "nix": {
        "enabled": true
    },
    "lockFileMaintenance": {
        "enabled": true,
        "automerge": false,
        "schedule": [
            "after 8am and before 12pm on sunday"
        ]
    },
    "packageRules": [
        {
            "description": "flake.lock and NixOS releases change the dev VMs: merging is the moment they change, so never automerge",
            "matchManagers": [
                "nix"
            ],
            "automerge": false
        },
        {
            "description": "Coder templates: raise the provider's minimum version (no lock file: pushes use the newest anyway)",
            "matchManagers": [
                "terraform"
            ],
            "rangeStrategy": "bump"
        }
    ]
}
