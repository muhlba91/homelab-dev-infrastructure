# Generated by homelab-dev-infrastructure from assets/hosts/[<order>-]<host>.yml: do not edit.
# Schema (types, defaults, validation): nix/modules/options/ of this repo.
{{- /*
Data: .Host = *host.Config (the parsed host file), .DeployKeys = []string (public keys of the deploy
user: the static ones from assets/ssh/*.pub plus the host's generated deploy key), .UserKeys =
[]string (public keys of the host's user: the static ones), .HostKey = string (the host's generated
public SSH host key; empty for a disabled host), .GitHubKey = string (the public GitHub machine key;
empty for a disabled host).

Conventions (as in the router repo):
- Nix lists are separated by whitespace, never by commas.
- text/template prints pointers dereferenced, but a field access through a nil pointer is a
  render error. Optional (omitempty) values are therefore only accessed inside `with`/`if`,
  and an unset optional value is not rendered at all: the Nix default applies, and a value
  Nix requires but the host file lacks fails the evaluation ("used but not defined")
  instead of rendering "<nil>".
- `with` on an empty list is false: an empty optional list is not rendered either (the parser
  rejects the empty lists where that would matter).
- Inside `range`/`with` the dot is the element; the root is `$`.
- Strings are not escaped: no value of a host file needs `"`, `${` or `\`.
*/}}
{
  dev = {
    {{- /* Always rendered: a host file is disabled unless it says `enabled: true`. */}}
    meta.deployable = {{ .Host.IsEnabled }};
    {{- with .Host.DeployOrder }}
    meta.deployOrder = {{ . }};
    {{- end }}
    {{- with .Host.Deploy }}{{ with .Automated }}
    meta.deployAutomated = {{ . }};
    {{- end }}{{ end }}

    host = {
      name = "{{ .Host.Name }}";
      hostname = "{{ .Host.Name }}";
      domain = "{{ .Host.Network.Domain }}";
    };

    mgmt = {
      address = "{{ with .Host.Network.ManagementAddress }}{{ . }}{{ else }}{{ .Host.Network.V4.Address }}{{ end }}";
      sshKeys = [
        {{- range .DeployKeys }}
        "{{ . }}"
        {{- end }}
      ];
      {{- with .HostKey }}
      hostKey = "{{ . }}";
      {{- end }}
    };

    {{- with .Host.Network.TrustedNetworks }}
    trusted = {
      {{- with .V4 }}
      v4 = [
        {{- range . }}
        "{{ . }}"
        {{- end }}
      ];
      {{- end }}
      {{- with .V6 }}
      v6 = [
        {{- range . }}
        "{{ . }}"
        {{- end }}
      ];
      {{- end }}
    };
    {{- end }}

    hardware = {
      profile = "{{ .Host.Hardware.Profile }}";
      disk = "{{ .Host.Hardware.Disk }}";
    };

    {{- with .Host.System }}
    {{- with .Watchdog }}
    system.watchdog = "{{ . }}";
    {{- end }}
    {{- with .GC }}
    {{- with .OlderThan }}
    system.gc.olderThan = "{{ . }}";
    {{- end }}
    {{- with .Keep }}
    system.gc.keep = {{ . }};
    {{- end }}
    {{- end }}
    {{- end }}

    network = {
      mac = "{{ .Host.Network.MAC }}";
      iface = "{{ .Host.Network.Interface }}";
      v4 = {
        address = "{{ .Host.Network.V4.Address }}/{{ .Host.Network.V4.Netmask }}";
        gateway = "{{ .Host.Network.V4.Gateway }}";
      };
      {{- with .Host.Network.V6 }}
      v6 = {
        address = "{{ .Address }}/{{ .Netmask }}";
        {{- with .Gateway }}
        gateway = "{{ . }}";
        {{- end }}
        {{- with .AcceptRA }}
        acceptRA = {{ . }};
        {{- end }}
      };
      {{- end }}
      {{- with .Host.Network.Nameservers }}
      nameservers = [
        {{- range . }}
        "{{ . }}"
        {{- end }}
      ];
      {{- end }}
    };

    user = {
      name = "{{ .Host.User.Name }}";
      uid = {{ .Host.User.UID }};
      sshKeys = [
        {{- range .UserKeys }}
        "{{ . }}"
        {{- end }}
      ];
      git = {
        name = "{{ .Host.User.Git.Name }}";
        email = "{{ .Host.User.Git.Email }}";
      };
      {{- with .GitHubKey }}
      githubKey = "{{ . }}";
      {{- end }}
    };

    {{- with .Host.Coder }}
    coder = {
      {{- with .Enabled }}
      enable = {{ . }};
      {{- end }}
      {{- with .AccessURL }}
      accessUrl = "{{ . }}";
      {{- end }}
    };
    {{- end }}
  };
}
