# Generated by homelab-dev-infrastructure from assets/hosts/[<order>-]<host>.yml: do not edit.
# Schema (types, defaults, validation): nix/modules/options/ of this repo.
{{- /*
Data: varsData (pkg/lib/host/vars.go).
- An optional value is rendered only inside `with`/`if` (a nil pointer is a render error); unset means the Nix
  default applies. `with` on an empty list is false: the parser rejects empty lists where that matters.
- Strings go through `nix` (quoted and escaped). Nix lists are whitespace-separated.
- Inside `range`/`with` the dot is the element; the root is `$`.
*/}}
{
  dev = {
    {{- /* Always rendered: a host file is disabled unless it says `enabled: true`. */}}
    meta.deployable = {{ .Host.IsEnabled }};
    {{- with .Host.DeployOrder }}
    meta.deployOrder = {{ . }};
    {{- end }}
    {{- with .Host.Deploy }}{{ with .Automated }}
    meta.deployAutomated = {{ . }};
    {{- end }}{{ end }}

    host = {
      name = {{ nix .Host.Name }};
      hostname = {{ nix .Host.Name }};
      domain = {{ nix .Host.Network.Domain }};
    };

    mgmt = {
      address = {{ with .Host.Network.ManagementAddress }}{{ nix . }}{{ else }}{{ nix .Host.Network.V4.Address }}{{ end }};
      sshKeys = [
        {{- range .DeployKeys }}
        {{ nix . }}
        {{- end }}
      ];
      {{- with .HostKey }}
      hostKey = {{ nix . }};
      {{- end }}
    };

    {{- with .Host.Network.TrustedNetworks }}
    trusted = {
      {{- with .V4 }}
      v4 = [
        {{- range . }}
        {{ nix . }}
        {{- end }}
      ];
      {{- end }}
      {{- with .V6 }}
      v6 = [
        {{- range . }}
        {{ nix . }}
        {{- end }}
      ];
      {{- end }}
    };
    {{- end }}

    hardware = {
      profile = {{ nix .Host.Hardware.Profile }};
      disk = {{ nix .Host.Hardware.Disk }};
    };

    {{- with .Host.System }}
    {{- with .Watchdog }}
    system.watchdog = {{ nix . }};
    {{- end }}
    {{- with .GC }}
    {{- with .OlderThan }}
    system.gc.olderThan = {{ nix . }};
    {{- end }}
    {{- with .Keep }}
    system.gc.keep = {{ . }};
    {{- end }}
    {{- end }}
    {{- end }}

    network = {
      mac = {{ nix .Host.Network.MAC }};
      iface = {{ nix .Host.Network.Interface }};
      v4 = {
        address = {{ nix (printf "%s/%d" .Host.Network.V4.Address .Host.Network.V4.Netmask) }};
        gateway = {{ nix .Host.Network.V4.Gateway }};
      };
      {{- with .Host.Network.V6 }}
      v6 = {
        address = {{ nix (printf "%s/%d" .Address .Netmask) }};
        {{- with .Gateway }}
        gateway = {{ nix . }};
        {{- end }}
        {{- with .AcceptRA }}
        acceptRA = {{ . }};
        {{- end }}
      };
      {{- end }}
      {{- with .Host.Network.Nameservers }}
      nameservers = [
        {{- range . }}
        {{ nix . }}
        {{- end }}
      ];
      {{- end }}
    };

    user = {
      name = {{ nix .Host.User.Name }};
      uid = {{ .Host.User.UID }};
      sshKeys = [
        {{- range .UserKeys }}
        {{ nix . }}
        {{- end }}
      ];
      git = {
        name = {{ nix .Host.User.Git.Name }};
        email = {{ nix .Host.User.Git.Email }};
      };
      {{- with .GitHubKey }}
      githubKey = {{ nix . }};
      {{- end }}
    };

    {{- with .Host.Docker }}
    docker = {
      {{- with .Enabled }}
      enable = {{ . }};
      {{- end }}
      {{- with .TrustedPorts }}
      trustedPorts = [
        {{- range . }}
        {{ nix . }}
        {{- end }}
      ];
      {{- end }}
    };
    {{- end }}

    {{- with .Host.Vault }}
    vault = {
      {{- with .Enabled }}
      enable = {{ . }};
      {{- end }}
      {{- with .Address }}
      address = {{ nix . }};
      {{- end }}
    };
    {{- end }}

    {{- with .BackupRepository }}
    backup.repository = {{ nix . }};
    {{- end }}

    {{- with .Host.Coder }}
    coder = {
      {{- with .Enabled }}
      enable = {{ . }};
      {{- end }}
      {{- with .AccessURL }}
      accessUrl = {{ nix . }};
      {{- end }}
      {{- with .WildcardAccessURL }}
      wildcardAccessUrl = {{ nix . }};
      {{- end }}
    };
    {{- end }}
  };
}
