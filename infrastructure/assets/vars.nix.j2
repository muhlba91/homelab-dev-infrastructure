# Generated by homelab-dev-infrastructure from assets/hosts/[<order>-]<host>.yml: do not edit.
# Schema (types, defaults, validation): nix/modules/options/ of this repo.
{{- /*
Data: varsData (pkg/lib/host/vars.go).
- An optional value is rendered only inside `with`/`if` (a nil pointer is a render error); unset means the Nix
  default applies. `with` on an empty list is false: the parser rejects empty lists where that matters.
- Nix lists are whitespace-separated. Strings are not escaped: no host value contains `"`, `${` or `\`.
- Inside `range`/`with` the dot is the element; the root is `$`.
*/}}
{
  dev = {
    {{- /* Always rendered: a host file is disabled unless it says `enabled: true`. */}}
    meta.deployable = {{ .Host.IsEnabled }};
    {{- with .Host.DeployOrder }}
    meta.deployOrder = {{ . }};
    {{- end }}
    {{- with .Host.Deploy }}{{ with .Automated }}
    meta.deployAutomated = {{ . }};
    {{- end }}{{ end }}

    host = {
      name = "{{ .Host.Name }}";
      hostname = "{{ .Host.Name }}";
      domain = "{{ .Host.Network.Domain }}";
    };

    mgmt = {
      address = "{{ with .Host.Network.ManagementAddress }}{{ . }}{{ else }}{{ .Host.Network.V4.Address }}{{ end }}";
      sshKeys = [
        {{- range .DeployKeys }}
        "{{ . }}"
        {{- end }}
      ];
      {{- with .HostKey }}
      hostKey = "{{ . }}";
      {{- end }}
    };

    {{- with .Host.Network.TrustedNetworks }}
    trusted = {
      {{- with .V4 }}
      v4 = [
        {{- range . }}
        "{{ . }}"
        {{- end }}
      ];
      {{- end }}
      {{- with .V6 }}
      v6 = [
        {{- range . }}
        "{{ . }}"
        {{- end }}
      ];
      {{- end }}
    };
    {{- end }}

    hardware = {
      profile = "{{ .Host.Hardware.Profile }}";
      disk = "{{ .Host.Hardware.Disk }}";
    };

    {{- with .Host.System }}
    {{- with .Watchdog }}
    system.watchdog = "{{ . }}";
    {{- end }}
    {{- with .GC }}
    {{- with .OlderThan }}
    system.gc.olderThan = "{{ . }}";
    {{- end }}
    {{- with .Keep }}
    system.gc.keep = {{ . }};
    {{- end }}
    {{- end }}
    {{- end }}

    network = {
      mac = "{{ .Host.Network.MAC }}";
      iface = "{{ .Host.Network.Interface }}";
      v4 = {
        address = "{{ .Host.Network.V4.Address }}/{{ .Host.Network.V4.Netmask }}";
        gateway = "{{ .Host.Network.V4.Gateway }}";
      };
      {{- with .Host.Network.V6 }}
      v6 = {
        address = "{{ .Address }}/{{ .Netmask }}";
        {{- with .Gateway }}
        gateway = "{{ . }}";
        {{- end }}
        {{- with .AcceptRA }}
        acceptRA = {{ . }};
        {{- end }}
      };
      {{- end }}
      {{- with .Host.Network.Nameservers }}
      nameservers = [
        {{- range . }}
        "{{ . }}"
        {{- end }}
      ];
      {{- end }}
    };

    user = {
      name = "{{ .Host.User.Name }}";
      uid = {{ .Host.User.UID }};
      sshKeys = [
        {{- range .UserKeys }}
        "{{ . }}"
        {{- end }}
      ];
      git = {
        name = "{{ .Host.User.Git.Name }}";
        email = "{{ .Host.User.Git.Email }}";
      };
      {{- with .GitHubKey }}
      githubKey = "{{ . }}";
      {{- end }}
    };

    {{- with .Host.Docker }}
    docker = {
      {{- with .Enabled }}
      enable = {{ . }};
      {{- end }}
      {{- with .TrustedPorts }}
      trustedPorts = [
        {{- range . }}
        "{{ . }}"
        {{- end }}
      ];
      {{- end }}
    };
    {{- end }}

    {{- with .Host.Vault }}
    vault = {
      {{- with .Enabled }}
      enable = {{ . }};
      {{- end }}
      {{- with .Address }}
      address = "{{ . }}";
      {{- end }}
    };
    {{- end }}

    {{- with .BackupRepository }}
    backup.repository = "{{ . }}";
    {{- end }}

    {{- with .Host.Coder }}
    coder = {
      {{- with .Enabled }}
      enable = {{ . }};
      {{- end }}
      {{- with .AccessURL }}
      accessUrl = "{{ . }}";
      {{- end }}
      {{- with .WildcardAccessURL }}
      wildcardAccessUrl = "{{ . }}";
      {{- end }}
    };
    {{- end }}
  };
}
